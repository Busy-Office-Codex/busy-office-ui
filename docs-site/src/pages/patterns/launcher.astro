---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
// Pre-compiled-source exception, not a package import: Launcher.tsx has no
// @busyoffice/design-system/examples/* subpath export (only app-shell, list-report and
// record-detail are in package.json's `exports` map today) — see docs-site/scripts/build-examples.mjs.
import { Launcher } from '../../generated/launcher.js';
import '../../generated/examples.css';

const entry = await getEntry('docs', 'launcher');
const { Content } = await render(entry);
---
<Base title="Launcher pattern">
  <a href="/">&larr; Home</a>
  <h1>Launcher</h1>
  {entry.data.category && <p class="category-badge">{entry.data.category}</p>}
  <p>
    Source:
    <a href="https://github.com/Busy-Office-Codex/busy-office-ui/blob/main/examples/Launcher.tsx">examples/Launcher.tsx</a>
  </p>

  <article>
    <Content />
  </article>

  <h2>Live demo</h2>
  <div class="live-demo">
    <Launcher client:load />
  </div>

  {entry.data.tests && entry.data.tests.length > 0 && (
    <>
      <h2>Tests</h2>
      <ul class="tests-list">
        {entry.data.tests.map((test) => <li>{test}</li>)}
      </ul>
    </>
  )}
</Base>
