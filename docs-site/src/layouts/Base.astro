---
import '@busyoffice/design-system/styles.css';

interface Props {
  title: string;
}
const { title } = Astro.props as Props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Busy Office UI docs</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Busy Office UI</a>
      <nav>
        <a href="/">Home</a>
        <a href="/tokens/">Tokens</a>
        <a href="/density/">Density</a>
        <a href="/base-styles/">Base Styles</a>
        <a href="/examples/">Examples</a>
        <a href="/quality/">Quality</a>
        <a href="/build-with-ai/">Build with AI</a>
        <a href="/layouts/">Layouts</a>
        <a href="/conventions/">Conventions</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      /*
        Chrome follows OS `prefers-color-scheme`, same as the real package (ROADMAP items 36-39:
        every `color.*` token now carries a light default plus a dark override). This file's own
        colors are plain literals, not real design-system tokens (docs-site doesn't import
        StyleX), so they're hand-kept in sync with `src/tokens.stylex.ts`'s `lightPalette`/
        `darkPalette` (bgCanvas/textPrimary/border/bgSubtle/textSecondary/bgSurface) rather than
        generated — see the Tokens page for the generated source of truth.

        Fixes a real regression, not a hypothetical: this file used to hardcode light chrome with
        a comment claiming the package was "light-only today." That was true when written but is
        false as of the theme milestone — an OS-dark-mode visitor was getting real dark-mode
        component colors (`Button variant="primary"`'s fill, `Text`, an active `Dropdown`/`Chip`)
        rendered inside a `.live-demo` box that stayed hardcoded light, the mirror image of the
        original bug this file's history already fixed once (found live, 2026-09-17, while
        fixing the Tokens page's own dark-mode drift in the same batch).
      */
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f8fafc;
        color: #0f172a;
      }
      a { color: inherit; }
      .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 24px;
        border-bottom: 1px solid #e2e8f0;
      }
      .site-header .brand { font-weight: 600; text-decoration: none; }
      .site-header nav { display: flex; gap: 16px; flex-wrap: wrap; }
      main { max-width: 1040px; margin: 0 auto; padding: 24px; box-sizing: border-box; }
      .live-demo-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        margin: 16px 0 0;
      }
      .live-demo {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 24px;
        margin: 16px 0;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-start;
        /* Containing block for any `position: fixed` descendant — without it, a fixed element
           ignores this box entirely and pins to the actual browser viewport, overlaying this
           page's own header/nav instead of staying inside its demo. Real, not hypothetical: both
           AppShell's own chrome (command bar/app strip/dock) AND Shell's own doc page (its live
           demo mounts a real `<Shell>`) use `position: fixed` — Shell's page had this exact,
           unnoticed escape bug before this fix too, not just AppShell's new one. `Modal`'s native
           `<dialog>` also has `position: fixed` but is unaffected either way: `showModal()`
           promotes it to the browser's own top layer, which ignores `contain` (and any ancestor
           stacking context) by design — a modal is SUPPOSED to render above everything, unlike a
           persistent shell chrome silently overlaying the page's own nav. */
        contain: layout;
      }
      pre {
        background: #0f172a;
        color: #f1f5f9;
        padding: 16px;
        border-radius: 10px;
        overflow-x: auto;
      }
      .tests-list { font-size: 14px; }
      table { border-collapse: collapse; width: 100%; margin: 16px 0 32px; }
      th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid #e2e8f0; font-size: 14px; vertical-align: top; }
      th { color: #475569; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
      blockquote {
        margin: 16px 0;
        padding: 4px 16px;
        border-left: 3px solid #cbd5e1;
        color: #334155;
      }
      blockquote p { margin: 8px 0; }
      .category-badge {
        display: inline-block;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #475569;
        background: #f1f5f9;
        border-radius: 999px;
        padding: 4px 12px;
        margin-bottom: 8px;
      }

      @media (prefers-color-scheme: dark) {
        body { background: #020617; color: #f8fafc; }
        .site-header { border-bottom-color: #334155; }
        .live-demo { background: #0f172a; border-color: #334155; }
        .category-badge { color: #cbd5e1; background: #1e293b; }
        th, td { border-bottom-color: #334155; }
        th { color: #cbd5e1; }
        blockquote { border-left-color: #475569; color: #cbd5e1; }
        /* `pre` stays on its own fixed dark palette in both modes (a conventional code-block
           look, not a case of the light-only bug above) — no override needed here. */
      }
    </style>
  </body>
</html>
