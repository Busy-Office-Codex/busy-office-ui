{
  "name": "@busyoffice/design-system",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22 <27"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/design-system.css",
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell.js"
    },
    "./examples/app-shell": {
      "types": "./dist/examples/AppShell.d.ts",
      "import": "./dist/examples/app-shell.js"
    },
    "./examples/list-report": {
      "types": "./dist/examples/ListReport.d.ts",
      "import": "./dist/examples/list-report.js"
    },
    "./examples/record-detail": {
      "types": "./dist/examples/RecordDetail.d.ts",
      "import": "./dist/examples/record-detail.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && tsc -p examples/tsconfig.build.json && node build.mjs",
    "build:preview": "node preview/build.mjs",
    "build:docs": "pnpm --filter docs-site build",
    "dev": "pnpm build:preview && pnpm preview",
    "lint": "eslint src examples preview test playwright.config.ts",
    "preview": "node preview/server.mjs",
    "security": "pnpm audit --prod --audit-level high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/tsconfig.json && tsc --noEmit -p preview/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "echarts": "^6.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@stylexjs/esbuild-plugin": "0.11.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
